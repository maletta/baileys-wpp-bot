# Database
DATABASE_URL="postgresql://username:password@localhost:5432/whatsapp_baileys_db"
MONGODB_URL="mongodb://localhost:27017/whatsapp_messages"

# JWT — sessão temporária de participante (formulário público)
JWT_PARTICIPANT_SECRET="change-me-participant-jwt"
JWT_PARTICIPANT_EXPIRES_SEC=86400

# Nome da app (mensagem de OTP no WhatsApp)
APP_DISPLAY_NAME="Minha aplicação"
PUBLIC_AUTH_LABEL_PUBLIC_FORM="Formulário"

# OTP / reenvio (opcional)
PUBLIC_AUTH_OTP_TTL_MS=86400000
PUBLIC_AUTH_ISSUE_MIN_INTERVAL_MS=90000
PUBLIC_AUTH_RESEND_COOLDOWN_MS=60000
PUBLIC_AUTH_RESEND_MAX=10
PUBLIC_AUTH_RATE_WINDOW_MS=900000
PUBLIC_AUTH_RATE_MAX_ISSUE=40
PUBLIC_AUTH_RATE_MAX_VERIFY=25
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key-here"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth
# IMPORTANTE: Use o MESMO Client ID do frontend
# GOOGLE_CLIENT_SECRET não é necessário para Google Identity Services (GIS)
# mas mantenha caso implemente fluxo tradicional no futuro
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GOOGLE_REDIRECT_URI não é usado no fluxo GIS atual, mas mantido para compatibilidade
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"

# WhatsApp/Baileys v7.0.0
SESSION_PATH="./sessions"
BAILEYS_BROWSER_NAME="Chrome"
BAILEYS_BROWSER_VERSION="1.0.0"
BAILEYS_VERSION="7.0.0-rc.6"
BAILEYS_LOG_LEVEL="silent"

# Server
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3333"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"
