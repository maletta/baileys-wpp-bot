{
  "name": "whatsapp-baileys-backend",
  "version": "1.0.0",
  "description": "Backend Node.js/TypeScript para WhatsApp Baileys API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "baileys": "^7.0.0-rc.3",
    "@prisma/client": "^5.22.0",
    "express": "^4.21.1",
    "socket.io": "^4.8.1",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "winston": "^3.17.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "dotenv": "^16.4.7",
    "mongoose": "^8.8.0",
    "google-auth-library": "^9.15.0",
    "qrcode-terminal": "^0.12.0",
    "qrcode": "^1.5.4",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/morgan": "^1.9.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.5",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/node": "^22.10.2",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
