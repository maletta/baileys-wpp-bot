# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================

# App Configuration
# URL base do frontend (usada para CORS e redirects)
# Desenvolvimento: http://localhost:3333
# Produção: https://seudominio.com
NEXT_PUBLIC_APP_URL="http://localhost:3333"

# API Configuration
# URL da API backend
# Desenvolvimento: http://localhost:3001/api
# Produção: https://api.seudominio.com/api
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Google OAuth
# Client ID obtido no Google Cloud Console
# Criar em: https://console.cloud.google.com/apis/credentials
# Tipo: "Aplicativo da Web"
# Origens JavaScript autorizadas:
#   - http://localhost:3333 (dev)
#   - http://127.0.0.1:3333 (dev)
#   - https://seudominio.com (prod)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# App Metadata
NEXT_PUBLIC_APP_NAME="WhatsApp Baileys"
NEXT_PUBLIC_APP_VERSION="1.0.0"
